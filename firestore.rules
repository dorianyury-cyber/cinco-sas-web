rules_version = '2';

// El sitio público (Inicio, Servicios, PQR, etc.) no tiene cuentas de
// usuario: la única colección que usa ("pqr") solo la escribe la Cloud
// Function enviarPQR con el Admin SDK, que no pasa por estas reglas — por
// eso no tiene ninguna regla de acceso explícita abajo y queda denegada
// por defecto.
//
// El módulo interno de Control de Contratos (web/control/*.html) tiene
// login (Firebase Auth, cuentas creadas a mano para el equipo) y perfiles
// en "empleados" (documento con id = email, porque todo el módulo ya
// identifica al usuario por user.email, nunca por uid). Cuatro roles:
// - admin: control total (incluido borrar contratos y administrar
//   empleados/roles — lo único que NO comparte con coadmin).
// - coadmin: edita todo lo de los contratos (datos, checklist completo,
//   equipo, documentos) igual que admin, pero no puede borrar contratos
//   ni tocar la colección "empleados" (roles/altas/bajas).
// - apoyo: dentro de "items" (el checklist) solo puede tocar las columnas
//   listadas en su empleados/{email}.camposPermitidos — el resto del
//   contrato (datos básicos, equipo) lo ve pero no lo edita.
// - empleado: sin permiso de escritura en contratos/items/documentos.
//   Ve lo que sus reglas de lectura permiten; qué columnas del checklist
//   se le muestran (camposVisibles) y el ocultamiento de "Ver"/"+ Agregar
//   documento" se resuelve en el cliente (contrato-detalle.js) — Firestore
//   no permite redactar campos sueltos de un documento en la lectura, así
//   que esa parte NO es una barrera de seguridad dura, solo de interfaz.
service cloud.firestore {
  match /databases/{database}/documents {

    function empleadoDoc() {
      return get(/databases/$(database)/documents/empleados/$(request.auth.token.email)).data;
    }
    function esEmpleadoActivo() {
      return request.auth != null && empleadoDoc().estado == 'activo';
    }
    function tieneRol(rol) {
      return esEmpleadoActivo() && empleadoDoc().rol == rol;
    }
    function esAdmin() { return tieneRol('admin'); }
    function esCoadmin() { return tieneRol('coadmin'); }
    // "Gestor" = puede administrar contratos de punta a punta salvo
    // borrarlos y tocar empleados (eso queda solo para esAdmin()).
    function esGestor() { return esAdmin() || esCoadmin(); }
    function esApoyo() { return tieneRol('apoyo'); }
    function enEquipo(datosContrato) {
      return esEmpleadoActivo() && request.auth.token.email in datosContrato.equipo;
    }
    function camposPermitidosApoyo() {
      return empleadoDoc().get('camposPermitidos', []);
    }
    // Permiso aparte del rol de contratos: quién puede dar de alta o
    // corregir el Listado Maestro de Documentos — admin siempre, o un
    // empleado puntual al que el admin se lo otorgue desde Empleados
    // (empleados/{email}.gestionaDocumentos).
    function gestionaDocumentos() {
      return esAdmin() || (esEmpleadoActivo() && empleadoDoc().get('gestionaDocumentos', false) == true);
    }
    // Permiso aparte del rol de contratos: quién debe leer y aprobar TODO
    // contrato nuevo (Administradora, Gerente...), otorgado desde Empleados
    // (empleados/{email}.aprobadorContratos) — sin importar si esa persona
    // está o no en el "equipo" de ese contrato puntual, por eso necesita
    // poder leer cualquier contrato (ver "allow read" abajo).
    function esAprobadorContratos() {
      return esEmpleadoActivo() && empleadoDoc().get('aprobadorContratos', false) == true;
    }
    // Un aprobador sin rol de gestor solo puede tocar SU PROPIA entrada
    // dentro de contratos/{id}.aprobaciones (mapa por email) — no puede
    // marcar la aprobación de otro ni tocar ningún otro campo del contrato.
    function soloTocaSuPropiaAprobacion() {
      let antes = resource.data.get('aprobaciones', {});
      let despues = request.resource.data.get('aprobaciones', {});
      return despues.diff(antes).affectedKeys().hasOnly([request.auth.token.email]);
    }

    // Directorio de empleados: cualquier autenticado lo lee (para elegir a
    // quién asignar a un contrato), solo un admin lo administra —
    // coadmin/apoyo/empleado no pueden cambiar roles ni de sí mismos ni
    // de nadie más.
    match /empleados/{email} {
      allow read: if request.auth != null;
      allow write: if esAdmin();
    }

    match /contratos/{contratoId} {
      allow read: if esGestor() || enEquipo(resource.data) || esAprobadorContratos();
      allow create: if esGestor();
      allow delete: if esAdmin();
      // Un aprobador (Administradora, Gerente...) sin rol de gestor puede
      // marcar/quitar SU aprobación aunque no pueda editar el resto del
      // contrato — ver esAprobadorContratos() y soloTocaSuPropiaAprobacion().
      allow update: if esGestor()
        || (esAprobadorContratos()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aprobaciones', 'actualizadoEn'])
            && soloTocaSuPropiaAprobacion());

      match /items/{itemId} {
        // esAprobadorContratos() incluido en la lectura porque
        // contrato-detalle.js carga el checklist para cualquiera que abra la
        // ficha del contrato, incluidos los aprobadores que no están en el
        // equipo ni son gestores.
        allow read: if esGestor() || enEquipo(get(/databases/$(database)/documents/contratos/$(contratoId)).data) || esAprobadorContratos();
        allow write: if esGestor()
          || (esApoyo()
              && enEquipo(get(/databases/$(database)/documents/contratos/$(contratoId)).data)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(camposPermitidosApoyo().concat(['actualizadoEn', 'actualizadoPor', 'historialEstado'])));
      }

      // Carpeta de documentos del contrato (referencias a "documentos" o
      // "correspondencia", o filas manuales). Igual que el resto del
      // contrato para leer; para crear/borrar filas, "empleado" queda
      // fuera (no puede archivar documentos), apoyo sí puede.
      match /documentos/{docId} {
        // Mismo motivo que en items/{itemId}: contrato-detalle.js carga esta
        // subcolección para cualquiera que abra la ficha, incluidos los
        // aprobadores que necesitan leer (y no solo aprobar a ciegas) el
        // documento real del contrato archivado aquí.
        allow read: if esGestor() || enEquipo(get(/databases/$(database)/documents/contratos/$(contratoId)).data) || esAprobadorContratos();
        allow write: if esGestor()
          || (esApoyo() && enEquipo(get(/databases/$(database)/documents/contratos/$(contratoId)).data));
      }
    }

    // Listado Maestro de Documentos (web/control/documentos.html) — catálogo
    // de toda la empresa, no de un contrato puntual. La lectura queda
    // abierta a cualquier autenticado (igual que Correspondencia debajo,
    // otros módulos necesitan poder consultarlo), pero crear/editar/borrar
    // un documento del catálogo (o su control de cambios) requiere
    // gestionaDocumentos() — antes estaba abierto a cualquiera y se
    // estaban colando errores de nombre/área/tipo al crear.
    // "contadores" guarda el siguiente consecutivo por área+tipo (y ahora
    // también por línea de servicio+año, para el código de contrato) para
    // generar los códigos sin choques.
    match /documentos/{documentoId} {
      allow read: if request.auth != null;
      // Alta manual desde "+ Nuevo documento" (sin "origen"): requiere el
      // permiso. Alta automática desde Informes/Ofertas/Correspondencia al
      // marcar "parteSGI" (trae "origen" propio): sigue abierta a
      // cualquier autenticado, igual que antes — si no, se rompería ese
      // flujo para cualquiera que no tenga gestionaDocumentos().
      allow create: if gestionaDocumentos()
        || (request.auth != null && request.resource.data.origen in ['informes', 'ofertas', 'correspondencia']);
      allow update, delete: if gestionaDocumentos();

      match /cambios/{cambioId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if gestionaDocumentos();
      }
    }

    match /contadores/{contadorId} {
      allow read, write: if request.auth != null;
    }

    // Correspondencia (web/control/correspondencia.html) — usa "contadores"
    // (doc "correspondencia_{año}"). Lectura abierta; crear/editar/borrar
    // requiere esGestor() (antes estaba abierto a cualquiera).
    match /correspondencia/{cartaId} {
      allow read: if request.auth != null;
      allow write: if esGestor();
    }

    // Informes de diseño propio (web/control/informes.html) — usa
    // "contadores" (doc "informe_{año}"). Lectura abierta a cualquier
    // autenticado; crear/editar/borrar requiere esGestor() (antes estaba
    // abierto a cualquiera, sin control real de quién publica qué).
    match /informes/{informeId} {
      allow read: if request.auth != null;
      allow write: if esGestor();
    }

    // Ofertas comerciales (web/control/ofertas.html) — usa "contadores"
    // (doc "oferta_{año}"). Lectura abierta; crear/editar/borrar requiere
    // esGestor() (antes estaba abierto a cualquiera).
    match /ofertas/{ofertaId} {
      allow read: if request.auth != null;
      allow write: if esGestor();
    }
  }
}
