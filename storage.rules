rules_version = '2';

// Mismo criterio en ambas rutas: cualquier usuario autenticado del Control
// de Contratos puede leer/escribir (el filtro fino de quién puede archivar
// qué contrato ya lo hacen las reglas de Firestore sobre
// contratos/{id}/documentos, no Storage).
service firebase.storage {
  match /b/{bucket}/o {
    // Imágenes que se insertan dentro de una carta de Correspondencia
    // (web/control/correspondencia.html).
    match /correspondencia/{cartaId}/{archivo} {
      allow read, write: if request.auth != null;
    }
    // PDF final de un documento manual archivado en un contrato (ej. el
    // informe mensual que se le envía al cliente) — "Documentos del
    // contrato" en contrato.html.
    match /contratos/{contratoId}/documentos/{archivo} {
      allow read, write: if request.auth != null;
    }
    // Documentos adjuntos a un ítem del checklist de un contrato (contrato.html):
    // hasta 25 MB; PDF, imágenes, Word y Excel. Quién puede adjuntar lo filtran
    // las reglas de Firestore sobre contratos/{id}/items.
    match /contratos/{contratoId}/items/{itemId}/{archivo} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          || request.resource.contentType == 'application/vnd.ms-excel'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
    }
    // Gráficos/imágenes insertados en un Informe de diseño propio
    // (web/control/informes.html).
    match /informes/{informeId}/{archivo} {
      allow read, write: if request.auth != null;
    }
    // Imagen de firma de un empleado autorizado a presentar ofertas
    // (web/control/empleados.html) — se sube una vez y se reusa en cada
    // oferta que esa persona firme (web/control/ofertas.html).
    match /empleados/{email}/{archivo} {
      allow read, write: if request.auth != null;
    }
    // Archivos de Interventoría PRO (web/interventoria-pro/*): fotos ya
    // comprimidas en el navegador (imágenes de hasta 10 MB) y documentos PDF
    // adjuntos a los registros o al contrato (hasta 20 MB).
    match /interventoria-pro/{contratoId}/{modulo}/{archivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.resource == null
          || (request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*'))
          || (request.resource.size < 20 * 1024 * 1024 && request.resource.contentType == 'application/pdf'));
    }
  }
}
